{
  "name": "@zig-wasm/pixel-to-ascii",
  "version": "0.1.0",
  "description": "High-performance video-to-ASCII converter using Zig WebAssembly and WebGPU",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "src-js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build:js",
    "build:wasm": "zig build wasm -Doptimize=ReleaseFast",
    "build:js": "tsc && node scripts/build-wrapper.mjs",
    "build:dev": "zig build wasm -Doptimize=Debug && tsc && node scripts/build-wrapper.mjs",
    "dev": "npm run build:dev && npm run dev:demo",
    "dev:demo": "vite demo",
    "demo:build": "npm run build && vite build demo",
    "demo:preview": "vite preview demo",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src-js --ext .ts,.tsx",
    "lint:fix": "eslint src-js --ext .ts,.tsx --fix",
    "release": "semantic-release --dry-run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "ascii",
    "video",
    "webassembly",
    "wasm",
    "zig",
    "webgpu",
    "gpu",
    "graphics",
    "shader",
    "renderer",
    "video-processing",
    "real-time",
    "pixel-art"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/pixel-to-ascii-zig.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/pixel-to-ascii-zig/issues"
  },
  "homepage": "https://github.com/yourusername/pixel-to-ascii-zig#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "semantic-release": "^23.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "volta": {
    "node": "20.10.0",
    "npm": "10.2.0"
  },
  "config": {
    "zig": {
      "version": "0.13.0"
    }
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
